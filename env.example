# Sentry DSN (Data Source Name)
# DSN harus disimpan di environment variable, JANGAN hardcode di kode
# Production dan staging sebaiknya menggunakan DSN yang berbeda
NEXT_PUBLIC_SENTRY_DSN=

# Toggle Sentry PII Filters
# true  = Filters AKTIF - Data sensitif akan di-scrub sesuai guideline
# false = Filters NON-AKTIF - Hanya untuk demo/development, data sensitif AKAN terkirim
# WAJIB: Di production, nilai ini harus bernilai true
NEXT_PUBLIC_SENTRY_ENABLE_FILTERS=true

# ============================================
# Additional Environment Variables (Optional)
# ============================================

# Environment identifier untuk membedakan error dari staging vs production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Release version untuk tracking error per versi
# NEXT_PUBLIC_SENTRY_RELEASE=v1.0.0

# Sample rate untuk performance monitoring (0.0 - 1.0)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Sample rate untuk session replay (jika fitur diaktifkan)
# SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.1
# SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1.0
